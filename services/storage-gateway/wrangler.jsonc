{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iyke-storage-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "r2_buckets": [
    {
      "binding": "STORAGE_BUCKET",
      "bucket_name": "iyke-cloud"
    }
  ],
  "vars": {
    "DEFAULT_CDN_HOST": "https://cdn.iykevisuals.com"
  },
  "observability": {
    "enabled": true
  }
}
