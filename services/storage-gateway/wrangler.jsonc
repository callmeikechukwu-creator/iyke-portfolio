{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iyke-storage-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "r2_buckets": [
    {
      "binding": "STORAGE_BUCKET",
      "bucket_name": "iyke-cloud"
    }
  ],
  "vars": {
    // Optional: override with your custom CDN domain later if you want.
    // If left empty or omitted, the gateway dynamically detects the caller's origin!
    "DEFAULT_CDN_HOST": ""
  },
  "observability": {
    "enabled": true
  }
}
